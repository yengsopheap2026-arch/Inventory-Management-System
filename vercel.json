{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "name": "inventory-management-system",
  "version": 2,
  "framework": null,
  "regions": ["iad1"],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-XSS-Protection",
          "value": "1; mode=block"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "/Stockflow - Inventory Management.html",
      "methods": ["GET"]
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/Stockflow - Inventory Management.html"
    }
  ],
  "cleanUrls": true,
  "trailingSlash": false,
  "output": "static"
}
