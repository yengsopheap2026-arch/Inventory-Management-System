generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model InventoryItem {
  id       Int     @id @default(autoincrement())
  sku      String  @unique
  name     String
  category String
  bin      String
  stock    Int     @default(0)
  reorder  Int     @default(10)
  price    Float   @default(0)
  supplier String
}

model Order {
  id        Int     @id @default(autoincrement())
  orderId   String  @unique
  type      String
  supplier  String
  itemName  String
  details   String
  status    String
  eta       String
  progress  Int     @default(1)
  createdAt DateTime @default(now())
}

model Supplier {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  contact  String
  email    String
  phone    String
  status   String  @default("Active")
}

model WarehouseZone {
  id           Int           @id @default(autoincrement())
  name         String
  description  String
  capacity     String
  capacityColor String
  bins         WarehouseBin[]
}

model WarehouseBin {
  id        Int         @id @default(autoincrement())
  zoneId    Int
  name      String
  value     String
  percentage Float
  color     String
  zone      WarehouseZone @relation(fields: [zoneId], references: [id])
}
